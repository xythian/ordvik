#!/usr/bin/env python3
"""Keep Claude attribution out of commits and pull requests.

Ken is the accountable author of every change (CLAUDE.md), so
commits and PR bodies carry no Claude author, Co-Authored-By trailer,
Claude-Session line or "Generated with Claude Code" footer. Agent sessions
are told to add those by their harness, and a cloud container's default
git identity is Claude, so this is enforced rather than remembered:

  check-attribution commits <range>   fail on a commit in the range (CI)
  check-attribution body              fail on a PR body read from stdin (CI)
  check-attribution strip <file>      remove the lines from a commit message (commit-msg hook)
  check-attribution author            fail if the configured author is Claude (pre-commit hook)

A public repository passes --public before the command (its workflow and
hooks do). Its history must not show the private planning behind it either:
no Dispatch: trailer (the planning repository links work through prs: on
the dispatch doc), no Claude project thread link, no path into a planning
repository's projects/, and nothing matching a pattern in $PUBLIC_DENY or
git config attribution.deny (one regular expression per line or value,
kept out of the repository; CI passes them from a secret).
"""

import os
import re
import subprocess
import sys

# Lines that are attribution and nothing else; strip removes them.
LINES = [
    re.compile(r"^\s*Co-Authored-By:.*(claude|anthropic)", re.I),
    re.compile(r"^\s*Claude-Session:", re.I),
    re.compile(r"^\W*Generated with \[Claude Code\]", re.I),
    re.compile(r"^\s*_?Generated by \[Claude Code\]", re.I),
    re.compile(r"^\s*https://claude\.ai/code/session_\S*\s*$", re.I),
]
# Anywhere in a text: a session link (the projects attribution header links
# a project thread, claude.ai/code/project/..., which is allowed).
ANYWHERE = [re.compile(r"claude\.ai/code/session_", re.I)]
AUTHOR = re.compile(r"noreply@anthropic\.com|^claude\b", re.I)

# --public: lines strip removes, and text found anywhere.
PUBLIC_LINES = [re.compile(r"^\s*Dispatch:\s", re.I)]
PUBLIC_ANYWHERE = [
    re.compile(r"claude\.ai/code/project/", re.I),
    re.compile(r"\bprojects/[A-Za-z0-9_.-]+/(dispatch|plans|asks)/"),
]


PUBLIC = " or names the private planning behind this public repository"
WHAT = ""


def public_mode():
    """Turn on the public checks."""
    global WHAT
    WHAT = PUBLIC
    LINES.extend(PUBLIC_LINES)
    ANYWHERE.extend(PUBLIC_LINES + PUBLIC_ANYWHERE)
    deny = os.environ.get("PUBLIC_DENY", "").splitlines()
    r = subprocess.run(["git", "config", "--get-all", "attribution.deny"], capture_output=True, text=True)
    deny += r.stdout.splitlines()
    ANYWHERE.extend(re.compile(d.strip(), re.I) for d in deny if d.strip())


def findings(text):
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        if any(p.search(line) for p in LINES) or any(p.search(line) for p in ANYWHERE):
            out.append(f"line {n}: {line.strip()}")
    return out


def strip(text):
    kept = [l for l in text.split("\n") if not any(p.search(l) for p in LINES)]
    while len(kept) > 1 and kept[-1].strip() == "" and kept[-2].strip() in ("", "---"):
        kept.pop()
        if kept[-1].strip() == "---":
            kept.pop()
    return "\n".join(kept).rstrip("\n") + "\n"


def git(*args):
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def cmd_commits(rng):
    bad = 0
    for sha in git("rev-list", "--no-merges", rng).split():
        an, ae, cn, ce = git("log", "-1", "--format=%an%x00%ae%x00%cn%x00%ce", sha).strip().split("\0")
        problems = []
        if AUTHOR.search(ae) or AUTHOR.search(an):
            problems.append(f"author {an} <{ae}>")
        if AUTHOR.search(ce) or AUTHOR.search(cn):
            problems.append(f"committer {cn} <{ce}>")
        problems += findings(git("log", "-1", "--format=%B", sha))
        for p in problems:
            print(f"{sha[:10]}: {p}")
        bad += bool(problems)
    if bad:
        print(f"\n{bad} commit(s) carry Claude attribution{WHAT}. Ken is the author of every change: "
              "re-author them (git rebase --exec 'git commit --amend --no-edit --reset-author' with "
              "user.name/user.email set to Ken) and drop the trailers, then force-push the branch.")
    return 1 if bad else 0


def cmd_body():
    problems = findings(sys.stdin.read())
    for p in problems:
        print(f"PR body {p}")
    if problems:
        print(f"\nThe PR body carries Claude attribution{WHAT}; edit it out"
              + ("." if WHAT else " (the projects attribution header is fine)."))
    return 1 if problems else 0


def cmd_strip(path):
    with open(path) as f:
        text = f.read()
    new = strip(text)
    if new != text:
        with open(path, "w") as f:
            f.write(new)
        print("check-attribution: removed Claude attribution lines from the commit message", file=sys.stderr)
    return 0


def cmd_author():
    ident = git("var", "GIT_AUTHOR_IDENT")
    if AUTHOR.search(ident):
        print(f"check-attribution: the commit author is {ident.rsplit('>', 1)[0]}>. Ken is the author of "
              "every change: git config user.name 'Ken Fox' && git config user.email fox@xythian.com",
              file=sys.stderr)
        return 1
    return 0


def main(argv):
    if argv[:1] == ["--public"]:
        public_mode()
        argv = argv[1:]
    if len(argv) >= 2 and argv[0] == "commits":
        return cmd_commits(argv[1])
    if argv == ["body"]:
        return cmd_body()
    if len(argv) == 2 and argv[0] == "strip":
        return cmd_strip(argv[1])
    if argv == ["author"]:
        return cmd_author()
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
