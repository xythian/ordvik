#!/bin/sh
# Run ordvik's CLI in the planning repository's checkout.
#
# The binary: $ORDVIK_BIN, else `ordvik` on PATH, else `go run` from a
# checkout of xythian/ordvik beside this one. The planning checkout:
# $ORDVIK_PLANNING, else planning/ beside this checkout, else
# ~/.cache/ordvik/planning (cloned on first use from .ordvik.yml's
# planning.repo). RFCs for `asks` come from
# the code checkouts beside it (ordvik's ORDVIK_REPOS overrides).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
root=$(git -C "$here" worktree list --porcelain | sed -n '1s/^worktree //p')
parent=$(dirname "$root")

planning=${ORDVIK_PLANNING:-}
if [ -z "$planning" ]; then
  for d in "$parent/planning" "$HOME/.cache/ordvik/planning"; do
    if [ -f "$d/planning.yml" ]; then planning=$d; break; fi
  done
fi
if [ -z "$planning" ]; then
  # .ordvik.yml's planning.repo (owner/name) names the repository to clone.
  repo=$(sed -n 's/^[[:space:]]*repo:[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$root/.ordvik.yml" 2>/dev/null | head -n 1)
  if [ -z "$repo" ]; then
    echo "ordvik: no planning checkout (set ORDVIK_PLANNING, or clone the planning repository beside $root)" >&2
    exit 1
  fi
  planning=$HOME/.cache/ordvik/planning
  echo "ordvik: cloning $repo into $planning" >&2
  mkdir -p "$(dirname "$planning")"
  git clone -q "https://github.com/$repo.git" "$planning"
fi

if [ -n "${ORDVIK_BIN:-}" ]; then
  set -- "$ORDVIK_BIN" "$@"
elif command -v ordvik >/dev/null 2>&1; then
  set -- ordvik "$@"
elif [ -f "$parent/ordvik/go.mod" ]; then
  bin=${XDG_CACHE_HOME:-$HOME/.cache}/ordvik/bin/ordvik
  mkdir -p "$(dirname "$bin")"
  (cd "$parent/ordvik" && go build -o "$bin" ./cmd/ordvik)
  set -- "$bin" "$@"
else
  echo "ordvik: no ordvik binary (set ORDVIK_BIN, put ordvik on PATH, or clone xythian/ordvik beside $root)" >&2
  exit 1
fi
cd "$planning"
exec "$@"
